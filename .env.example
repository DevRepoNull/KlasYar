# ==============================================================================
# KlasYar - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' or '.env.local' to configure your environment.
# Note: KlasYar runs 100% offline with IndexedDB by default.
# The PocketBase variables below are optional for future multi-device synchronization.
# ==============================================================================

# Application Meta
VITE_APP_NAME="کلاس‌یار"
VITE_APP_VERSION="0.3.0"

# PocketBase Backend Configuration (Optional / Future Roadmap v0.3)
# Set your self-hosted PocketBase server URL here if enabling cloud sync:
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Feature Flags
# Enable or disable optional remote sync (true / false)
VITE_ENABLE_REMOTE_SYNC=false

# Optional Telemetry (Kept false for privacy)
VITE_ENABLE_TELEMETRY=false
